# ============================================================================
# Model provider — pick ONE of the two modes below.
# ============================================================================

# ---- Mode A: OpenAI-compatible (use this for OpenAI / Azure / OpenRouter /
#      Ollama / 公司内网兼容模型 / any "v1/chat/completions" endpoint) ----------
MODEL_PROVIDER=openai
MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-or-company-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# 公司内网自建模型若用自签名证书, 设 false 跳过 TLS 校验:
SSL_VERIFY=true
# 公司内网示例（替换成实际地址，注意通常以 /v1 结尾）：
#   OPENAI_BASE_URL=http://10.x.x.x:8000/v1
#   MODEL=company-internal-model-name
#   SSL_VERIFY=false

# ---- Mode B: Anthropic-protocol (BigModel GLM-5.2, Anthropic, Z.ai, …) -------
# 取消注释下面 4 行，并注释掉 Mode A 的 MODEL_PROVIDER 才会启用：
# MODEL_PROVIDER=anthropic
# MODEL=GLM-5.2
# ANTHROPIC_API_KEY=your-bigmodel-key-here
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# ============================================================================
# Workspace & history (usually leave as defaults)
# ============================================================================

# --- Directory the agent operates on (real local files) --------------------
# Leave blank / unset to default to the server's current working directory.
WORKDIR=

# --- Conversation history persistence (checkpointer) -----------------------
# SQLite (default, zero-dependency):
DATABASE_URL=sqlite:///./data/checkpoints.db
# Postgres (optional): postgresql+psycopg://user:pass@host:5432/openmanus

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8999
CORS_ORIGINS=*

# ============================================================================
# Retry / 指数退避 (公司内网模型限流 429、网络抖动场景)
# ============================================================================
# 基于 langchain 内置的 ModelRetryMiddleware / ToolRetryMiddleware。
# 仅对「瞬时错误」重试:429 RateLimit / 超时 / 连接错误 / 5xx / httpx 网络错误。
# 4xx 客户端错误(401 认证、400 参数错误)不重试 —— 重试无用且浪费时间。

# --- 模型调用重试 (LLM API, 默认开启) -------------------------------------
# 公司内网/自托管模型经常限流,这里做指数退避重试透明兜住瞬时错误。
MODEL_RETRY_ENABLED=true
# 总尝试次数(含首次)。例如 3 = 首次 + 2 次重试。
MODEL_RETRY_MAX_ATTEMPTS=3
# 首次重试前等待秒数。
MODEL_RETRY_INITIAL_DELAY=1.0
# 指数退避乘数:第 n 次重试等待 initial_delay * backoff_factor ** n。
# 设 0.0 = 固定间隔(不指数增长)。
MODEL_RETRY_BACKOFF_FACTOR=2.0
# 单次等待上限(秒),封顶指数退避增长。
MODEL_RETRY_MAX_DELAY=60.0
# ±25% 随机抖动,避免多个并发请求同步重试导致惊群。
MODEL_RETRY_JITTER=true
# 所有重试用尽后:continue = 降级返回错误消息,agent 继续(默认);
# error = 向上抛出,中断 agent 执行。
MODEL_RETRY_ON_FAILURE=continue

# --- 工具调用重试 (文件/shell 为确定性操作, 默认关闭) ----------------------
# 文件读写/shell 命令多为确定性操作,重试通常无意义(再次执行结果相同)。
# 若挂了不稳定的远程工具(MCP/网络),可按需开启。
TOOL_RETRY_ENABLED=false
TOOL_RETRY_MAX_ATTEMPTS=2
TOOL_RETRY_INITIAL_DELAY=0.5
TOOL_RETRY_BACKOFF_FACTOR=2.0
TOOL_RETRY_MAX_DELAY=30.0
TOOL_RETRY_JITTER=true
TOOL_RETRY_ON_FAILURE=continue
